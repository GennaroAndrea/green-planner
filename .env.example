# Copy to .env (gitignored) on the demo laptop. Loaded by `make demo` and `python -m backend.admin`.
# Never commit real values; on Render, leave these unset (the chat stays hidden there, Q54).

# Admin secret for the chat access API (long and random, e.g. `openssl rand -base64 32`).
# Without it the chat is unavailable.
GREEN_PLANNER_ADMIN_SECRET=

# Anthropic API key for the chat (Q53), from the Claude Console.
ANTHROPIC_API_KEY=

# Optional
# Chat test mode: questions starting with /test get canned answers, no API call (keep off
# for the real demo)
# GREEN_PLANNER_CHAT_TEST_MODE=1
# GREEN_PLANNER_CHAT_DB=data/interim/chat_auth.sqlite
